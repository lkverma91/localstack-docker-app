# =============================================================================
# Production / real AWS — template only. Copy to ".env" and set real values.
# Do not commit ".env". See docs/aws-production.md
# =============================================================================
# Activate Spring profile "prod" and load this file when supported (e.g. IDE,
# docker compose --env-file, or export before java -jar). Variable names match
# Spring Boot relaxed binding (e.g. APP_AWS_ENDPOINT → app.aws.endpoint).
# =============================================================================

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- MySQL (e.g. Amazon RDS) ---
SPRING_DATASOURCE_URL=jdbc:mysql://your-rds-endpoint.region.rds.amazonaws.com:3306/authdb?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT (use a long random Base64 secret; never reuse dev keys) ---
JWT_SECRET=REPLACE_WITH_BASE64_HMAC_KEY_AT_LEAST_256_BITS
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=86400000

# --- AWS (real accounts — leave endpoint empty) ---
# Empty = real AWS SDK endpoints + DefaultCredentialsProvider (IAM role, env keys, or ~/.aws/credentials)
APP_AWS_ENDPOINT=
AWS_REGION=us-east-1

# Optional: only if not using IAM instance/task role (e.g. local prod-like test)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 bucket for app storage (create in console or IaC; IAM policy must allow s3:PutObject/GetObject as needed)
AWS_S3_BUCKET=your-company-auth-app-profiles

# SES: verified identity (domain or email) in this region — must match what the app sends as "From"
APP_AWS_SES_FROM_EMAIL=noreply@verified.example.com

# Optional: first deploy only — then remove or set back to validate
# JPA_DDL_AUTO=update
